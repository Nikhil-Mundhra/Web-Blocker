{
  "manifest_version": 3,
  "name": "ScrollTax",
  "description": "A tax on doomscrolling. Block distracting websites and take back your attention.",
  "version": "0.2.0",
  "icons": {
    "32": "icon_32.png",
    "128": "icon_128.png"
  },
  "action": {
    "default_icon": {
      "32": "icon_32.png",
      "128": "icon_128.png"
    },
    "default_popup": "popup.html"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "permissions": [
    "storage",
    "tabs",
    "webNavigation",
    "contextMenus"
  ],
  "background": {
    "scripts": ["background.mjs"],
    "type": "module"
  },
  "incognito": "spanning",
  "browser_specific_settings": {
    "gecko": {
      "id": "{7C4E2B91-3A6D-4F08-9B5E-2D8A1C6F3E74}",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  }
}